<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#1a1a2e">
<title>ISSEO Assistant</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<style>
:root{
  --or:#EA7807;--or-l:#FEF0E0;--or-d:#B85E00;
  --te:#3AB6AD;--te-l:#E0F5F4;--te-d:#1E7A74;
  --gr:#888;--gr-l:#F4F4F2;--bd:#D8D6D0;
  --dk:#1a1a2e;--wh:#fff;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;background:#f0f2f5;font-family:'DM Sans',sans-serif;color:var(--dk)}
.app{max-width:430px;margin:0 auto;height:100dvh;display:flex;flex-direction:column;background:#f0f2f5}

/* LOGIN */
.login{position:fixed;inset:0;background:var(--dk);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;padding:24px;z-index:999}
.login img{width:130px}
.login-sub{font-size:16px;font-weight:600;color:var(--wh);margin-top:-10px}
.login-hint{font-size:12px;color:rgba(255,255,255,.4)}
.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;width:100%}
.pc{background:rgba(255,255,255,.07);border:1.5px solid rgba(255,255,255,.1);border-radius:12px;padding:14px 6px;display:flex;flex-direction:column;align-items:center;gap:7px;cursor:pointer;transition:all .2s}
.pc:active{transform:scale(.95)}
.pc-av{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;color:var(--wh)}
.pc-name{font-size:11px;font-weight:600;color:var(--wh)}
.pc-role{font-size:9px;color:rgba(255,255,255,.4)}
.login-go{width:100%;padding:14px;background:var(--te);border:none;border-radius:10px;font-size:15px;font-weight:600;color:var(--wh);cursor:pointer;display:none;font-family:'DM Sans',sans-serif}
.login-go.show{display:block}

/* HEADER */
.hdr{background:var(--dk);padding:10px 14px 8px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.hdr-logo{height:24px}
.hdr-r{display:flex;align-items:center;gap:8px}
.sv{font-size:10px;color:var(--te);opacity:0;transition:opacity .3s;font-family:'DM Mono',monospace}
.sv.on{opacity:1}
.hdr-pf{display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.08);border-radius:99px;padding:4px 10px 4px 4px;cursor:pointer}
.hdr-av{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:var(--wh)}
.hdr-nm{font-size:11px;font-weight:500;color:var(--wh)}

/* TABS */
.tabs{background:var(--wh);border-bottom:1px solid var(--bd);display:grid;grid-template-columns:repeat(4,1fr);flex-shrink:0}
.tab{padding:8px 4px;font-size:10px;font-weight:500;border:none;background:transparent;color:var(--gr);cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;border-bottom:2.5px solid transparent;transition:all .15s;font-family:'DM Sans',sans-serif}
.tab i{font-size:18px}
.tab.on{color:var(--te);border-bottom-color:var(--te)}

/* SCROLL */
.content{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch}
.pane{display:none;flex-direction:column;gap:10px;padding:12px}
.pane.on{display:flex}

/* CARD */
.card{background:var(--wh);border:0.5px solid var(--bd);border-radius:14px;padding:12px 14px}
.chdr{font-size:10px;font-weight:600;color:var(--gr);text-transform:uppercase;letter-spacing:.06em;margin-bottom:9px;display:flex;align-items:center;justify-content:space-between}
.chdr i{color:var(--te);font-size:14px;margin-right:4px}

/* STATS */
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.st{border-radius:12px;padding:12px 14px}
.st-n{font-size:26px;font-weight:600;font-family:'DM Mono',monospace;line-height:1}
.st-l{font-size:10px;margin-top:3px;opacity:.7}

/* QUICK */
.qgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}
.qbtn{background:var(--wh);border:0.5px solid var(--bd);border-radius:11px;padding:10px;display:flex;align-items:center;gap:8px;cursor:pointer}
.qbtn:active{background:var(--gr-l)}
.qic{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.qtxt{font-size:12px;font-weight:500;color:var(--dk);line-height:1.2}
.qsub{font-size:9px;color:var(--gr);margin-top:1px}

/* INPUT */
.inzone{background:var(--wh);border:0.5px solid var(--bd);border-radius:14px;padding:10px 12px;display:flex;flex-direction:column;gap:8px}
.intop{display:flex;align-items:center;justify-content:space-between}
.inlbl{font-size:10px;color:var(--gr);font-weight:500}
.wpill{font-size:10px;font-weight:600;padding:3px 9px;border-radius:99px}
.phrow{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
.phth{position:relative;width:46px;height:46px;border-radius:8px;flex-shrink:0}
.phth img{width:46px;height:46px;border-radius:8px;object-fit:cover;display:block;border:0.5px solid var(--bd)}
.phrm{position:absolute;top:-4px;right:-4px;width:16px;height:16px;border-radius:50%;background:#E24B4A;color:#fff;font-size:10px;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-weight:700}
.addph{width:46px;height:46px;border-radius:8px;border:1.5px dashed var(--bd);background:var(--gr-l);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;color:var(--gr);font-size:9px;gap:1px;flex-shrink:0}
.addph i{font-size:19px}
.irow{display:flex;gap:6px;align-items:flex-end}
.ibox{flex:1;background:var(--gr-l);border:0.5px solid var(--bd);border-radius:10px;padding:9px 10px;font-size:13px;color:var(--dk);min-height:42px;resize:none;outline:none;font-family:'DM Sans',sans-serif;line-height:1.4}
.ibox::placeholder{color:#B4B2A9}
.bmic{width:42px;height:42px;border-radius:10px;background:var(--gr-l);border:0.5px solid var(--bd);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--gr);flex-shrink:0}
.bmic.rec{background:#FCEBEB;border-color:#F09595;color:#A32D2D;animation:pulse .9s infinite}
.bsend{width:42px;height:42px;border-radius:10px;background:var(--te);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--wh);font-size:18px;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* RESP */
.resp{background:var(--gr-l);border:0.5px solid var(--bd);border-radius:14px;padding:11px 13px;display:none}
.resp.on{display:block}
.rhdr{display:flex;align-items:center;gap:6px;margin-bottom:7px}
.rtype{font-size:10px;font-weight:600;color:var(--gr);text-transform:uppercase;letter-spacing:.05em}
.rbody{font-size:13px;color:var(--dk);line-height:1.6;white-space:pre-wrap}
.rphotos{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:7px}
.rphotos img{width:56px;height:56px;border-radius:8px;object-fit:cover}
.racts{display:flex;gap:5px;margin-top:8px;flex-wrap:wrap}
.racts button{font-size:11px;padding:5px 10px;border-radius:99px;border:0.5px solid var(--bd);background:var(--wh);color:var(--dk);cursor:pointer;font-family:'DM Sans',sans-serif}
.ld{display:inline-flex;gap:3px;align-items:center;padding:4px 0}
.ld span{width:5px;height:5px;border-radius:50%;background:var(--te);animation:dt .8s infinite}
.ld span:nth-child(2){animation-delay:.15s}
.ld span:nth-child(3){animation-delay:.3s}
@keyframes dt{0%,100%{opacity:.2}50%{opacity:1}}

/* TASKS */
.tlist{display:flex;flex-direction:column;gap:5px}
.ti{background:var(--wh);border:0.5px solid var(--bd);border-radius:11px;padding:9px 11px;display:flex;align-items:flex-start;gap:8px;cursor:pointer}
.ti:active{background:var(--gr-l)}
.tic{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.tb{flex:1;min-width:0}
.tt{font-size:12px;font-weight:500;color:var(--dk);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tm{font-size:10px;color:var(--gr);margin-top:2px;display:flex;gap:4px;align-items:center;flex-wrap:wrap}
.tck{width:20px;height:20px;border-radius:50%;border:1.5px solid var(--bd);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;margin-top:4px;color:transparent;font-size:11px;transition:all .15s}
.tck.done{background:var(--te);border-color:var(--te);color:var(--wh)}
.ubadge{font-size:9px;font-weight:600;padding:1px 6px;border-radius:99px;background:#FCEBEB;color:#A32D2D;margin-left:4px}

/* REDIST */
.redist{background:var(--or-l);border:1.5px solid var(--or);border-radius:14px;padding:11px 13px;display:none}
.rdhdr{font-size:11px;font-weight:600;color:var(--or-d);margin-bottom:8px;display:flex;align-items:center;gap:5px}
.rdi{background:var(--wh);border:0.5px solid var(--bd);border-radius:9px;padding:8px 10px;margin-bottom:5px;display:flex;align-items:center;gap:8px}
.rdt{flex:1;font-size:12px;font-weight:500;color:var(--dk);min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rds{font-size:11px;padding:4px 7px;border-radius:7px;border:0.5px solid var(--bd);background:var(--gr-l);color:var(--dk)}
.rdgo{width:100%;padding:9px;font-size:12px;font-weight:600;border-radius:9px;border:none;background:var(--or);color:var(--wh);cursor:pointer;margin-top:4px;font-family:'DM Sans',sans-serif;display:flex;align-items:center;justify-content:center;gap:5px}

/* PLANNING */
.wnav{display:flex;align-items:center;justify-content:space-between}
.wlbl{font-size:12px;font-weight:500;color:var(--dk);font-family:'DM Mono',monospace}
.narr{width:30px;height:30px;border-radius:8px;border:0.5px solid var(--bd);background:var(--wh);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--gr);font-size:16px}
.dc{background:var(--wh);border:0.5px solid var(--bd);border-radius:11px;overflow:hidden}
.dc.tod{border-color:var(--te);border-width:1.5px}
.dhdr{padding:7px 11px;display:flex;align-items:center;justify-content:space-between;border-bottom:0.5px solid var(--bd)}
.dnm{font-size:11px;font-weight:600;color:var(--dk)}
.dc.tod .dnm{color:var(--te)}
.ddt{font-size:10px;color:var(--gr);font-family:'DM Mono',monospace}
.devts{padding:5px 8px;display:flex;flex-direction:column;gap:3px}
.ev{border-radius:6px;padding:4px 7px;display:flex;align-items:center;gap:5px}
.et{font-size:9px;font-weight:600;min-width:28px;flex-shrink:0}
.etl{font-size:11px;font-weight:500;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ewho{font-size:8px;font-weight:600;padding:1px 6px;border-radius:99px;flex-shrink:0}
.demp{font-size:10px;color:#B4B2A9;padding:6px 11px}
.dadd{width:100%;padding:5px;font-size:10px;color:var(--gr);background:transparent;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:3px;border-top:0.5px solid var(--bd);font-family:'DM Sans',sans-serif}

/* ÉQUIPE */
.mlist{display:flex;flex-direction:column;gap:6px}
.mi{background:var(--wh);border:0.5px solid var(--bd);border-radius:11px;padding:10px 12px;display:flex;align-items:center;gap:10px}
.mav{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:var(--wh);flex-shrink:0}
.minf{flex:1;min-width:0}
.mnm{font-size:13px;font-weight:500;color:var(--dk)}
.mrl{font-size:10px;color:var(--gr);margin-top:1px}
.mtk{font-size:10px;font-weight:500;padding:3px 8px;border-radius:99px}

/* BOUTONS */
.brow{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}
.btn{padding:10px;font-size:11px;font-weight:500;border-radius:10px;border:0.5px solid var(--bd);background:var(--wh);color:var(--dk);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;font-family:'DM Sans',sans-serif}
.btn:active{opacity:.85}
.btn.te{background:var(--te);border-color:var(--te);color:var(--wh)}
.btn.or{background:var(--or);border-color:var(--or);color:var(--wh)}
.btn.dk{background:var(--dk);border-color:var(--dk);color:var(--wh)}
.btn.fw{width:100%}

/* RECAP */
.rcbox{font-size:12px;color:var(--dk);line-height:1.7;white-space:pre-wrap;background:var(--gr-l);border-radius:10px;padding:11px 13px;margin-top:8px}

/* MODAL */
.mbg{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:500;display:none;align-items:flex-end;justify-content:center}
.mbg.on{display:flex}
.modal{background:var(--wh);border-radius:20px 20px 0 0;padding:14px 14px 34px;width:100%;max-width:430px;max-height:90vh;overflow-y:auto}
.mdrag{width:36px;height:4px;background:var(--bd);border-radius:2px;margin:0 auto 12px}
.mt{font-size:14px;font-weight:600;color:var(--dk);margin-bottom:12px}
.fl{font-size:10px;color:var(--gr);margin-bottom:3px;font-weight:500}
.fi{width:100%;background:var(--gr-l);border:0.5px solid var(--bd);border-radius:8px;padding:9px 10px;font-size:13px;color:var(--dk);outline:none;font-family:'DM Sans',sans-serif;margin-bottom:9px}
.fi::placeholder{color:#B4B2A9}
.g2{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:9px}
.tpg{display:grid;grid-template-columns:repeat(2,1fr);gap:5px;margin-bottom:9px}
.tp{padding:7px;font-size:11px;border-radius:8px;border:0.5px solid var(--bd);background:var(--gr-l);color:var(--gr);cursor:pointer;text-align:center;font-family:'DM Sans',sans-serif}
.whog{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:9px}
.wb{padding:5px 11px;font-size:11px;font-weight:500;border-radius:99px;border:1px solid var(--bd);background:var(--gr-l);color:var(--gr);cursor:pointer;font-family:'DM Sans',sans-serif}
.macts{display:flex;gap:6px;margin-top:4px}
.mcancel{flex:1;padding:11px;font-size:12px;border-radius:9px;border:0.5px solid var(--bd);background:var(--gr-l);color:var(--gr);cursor:pointer;font-family:'DM Sans',sans-serif}
.msave{flex:2;padding:11px;font-size:12px;font-weight:600;border-radius:9px;border:none;background:var(--te);color:var(--wh);cursor:pointer;font-family:'DM Sans',sans-serif}
</style>
</head>
<body>

<!-- LOGIN -->
<div class="login" id="loginScreen">
  <img src="/logo.jpg" alt="ISSEO" onerror="this.style.display='none'">
  <div style="text-align:center">
    <div style="font-size:11px;color:rgba(255,255,255,.4);letter-spacing:.1em">ASSISTANT IA</div>
    <div class="login-sub">Qui êtes-vous ?</div>
  </div>
  <div class="pgrid" id="pgrid"></div>
  <button class="login-go" id="loginGo" onclick="doLogin()">Commencer ma journée →</button>
</div>

<div class="app" id="mainApp" style="display:none">
  <div class="hdr">
    <img src="/logo.jpg" class="hdr-logo" alt="ISSEO" onerror="this.style.display='none'">
    <div class="hdr-r">
      <div class="sv" id="sv"><i class="ti ti-cloud-check" style="font-size:11px"></i> ok</div>
      <div class="hdr-pf" onclick="doLogout()" id="hdrPf">
        <div class="hdr-av" id="hdrAv"></div>
        <div class="hdr-nm" id="hdrNm"></div>
        <i class="ti ti-chevron-down" style="font-size:11px;color:rgba(255,255,255,.4)"></i>
      </div>
    </div>
  </div>

  <div class="tabs">
    <button class="tab on" id="t-home" onclick="gt('home')"><i class="ti ti-home"></i>Accueil</button>
    <button class="tab" id="t-plan" onclick="gt('plan')"><i class="ti ti-calendar"></i>Planning</button>
    <button class="tab" id="t-team" onclick="gt('team')"><i class="ti ti-users"></i>Équipe</button>
    <button class="tab" id="t-recap" onclick="gt('recap')"><i class="ti ti-report"></i>Récap</button>
  </div>

  <div class="content" id="ct">

    <!-- ACCUEIL -->
    <div class="pane on" id="p-home">
      <div class="stats">
        <div class="st" style="background:var(--te-l)"><div class="st-n" id="sT" style="color:var(--te-d)">0</div><div class="st-l" style="color:var(--te-d)">Tâches</div></div>
        <div class="st" style="background:var(--or-l)"><div class="st-n" id="sD" style="color:var(--or-d)">0</div><div class="st-l" style="color:var(--or-d)">Terminées</div></div>
      </div>

      <div class="card">
        <div class="chdr"><span><i class="ti ti-bolt"></i>Actions rapides</span></div>
        <div class="qgrid">
          <div class="qbtn" onclick="qp('Intervention chez ')">
            <div class="qic" style="background:var(--te-l)"><i class="ti ti-tool" style="color:var(--te-d)"></i></div>
            <div><div class="qtxt">Intervention</div><div class="qsub">Dépannage / visite</div></div>
          </div>
          <div class="qbtn" onclick="qp('Devis pour ')">
            <div class="qic" style="background:var(--or-l)"><i class="ti ti-file-invoice" style="color:var(--or-d)"></i></div>
            <div><div class="qtxt">Devis</div><div class="qsub">Offre commerciale</div></div>
          </div>
          <div class="qbtn" onclick="qp('Commander pièce ')">
            <div class="qic" style="background:#FAECE7"><i class="ti ti-package" style="color:#993C1D"></i></div>
            <div><div class="qtxt">Pièces</div><div class="qsub">Commander / identifier</div></div>
          </div>
          <div class="qbtn" onclick="qp('Planifier ')">
            <div class="qic" style="background:#EEF0FE"><i class="ti ti-calendar" style="color:#534AB7"></i></div>
            <div><div class="qtxt">Planning</div><div class="qsub">RDV / intervention</div></div>
          </div>
          <div class="qbtn" onclick="qp('Rappeler ')">
            <div class="qic" style="background:#E8F3DE"><i class="ti ti-phone" style="color:#3B6D11"></i></div>
            <div><div class="qtxt">Rappel</div><div class="qsub">Client / fournisseur</div></div>
          </div>
          <div class="qbtn" onclick="qp('Envoyer un mail à ')">
            <div class="qic" style="background:var(--gr-l)"><i class="ti ti-mail" style="color:var(--gr)"></i></div>
            <div><div class="qtxt">Mail</div><div class="qsub">Rédiger / envoyer</div></div>
          </div>
          <div class="qbtn" onclick="openRedist()">
            <div class="qic" style="background:var(--or-l)"><i class="ti ti-arrows-transfer-down" style="color:var(--or-d)"></i></div>
            <div><div class="qtxt">Redistribuer</div><div class="qsub">Déléguer à l'équipe</div></div>
          </div>
          <div class="qbtn" onclick="qp('Sécurité : ')">
            <div class="qic" style="background:#FCEBEB"><i class="ti ti-shield-check" style="color:#A32D2D"></i></div>
            <div><div class="qtxt">Sécurité</div><div class="qsub">Incident / consigne</div></div>
          </div>
        </div>
      </div>

      <div class="redist" id="redistCard">
        <div class="rdhdr"><i class="ti ti-arrows-transfer-down" style="font-size:15px"></i>Redistribuer</div>
        <div id="rdList"></div>
        <button class="rdgo" onclick="confirmRedist()"><i class="ti ti-check"></i> Valider</button>
      </div>

      <div class="inzone">
        <div class="intop">
          <span class="inlbl"><i class="ti ti-message" style="font-size:13px;vertical-align:-2px"></i> Instruction</span>
          <span class="wpill" id="wpill" style="background:var(--te-l);color:var(--te-d)">Joan</span>
        </div>
        <div class="phrow" id="phRow">
          <div class="addph" onclick="document.getElementById('fi').click()"><i class="ti ti-camera"></i><span>Photo</span></div>
          <input type="file" id="fi" accept="image/*" multiple capture="environment" style="display:none" onchange="addPh(this)">
        </div>
        <div class="irow">
          <textarea class="ibox" id="uIn" rows="2" placeholder="Dictez ou tapez votre instruction..."></textarea>
          <button class="bmic" id="micBtn" onclick="toggleMic()"><i class="ti ti-microphone"></i></button>
          <button class="bsend" onclick="doSend()"><i class="ti ti-arrow-up"></i></button>
        </div>
      </div>

      <div class="resp" id="resp">
        <div class="rhdr">
          <div style="width:7px;height:7px;border-radius:50%;flex-shrink:0;background:var(--te)" id="rdot"></div>
          <div class="rtype" id="rtype">Agent</div>
          <div style="flex:1"></div>
          <div id="rwho" style="font-size:9px;font-weight:600;padding:2px 8px;border-radius:99px"></div>
        </div>
        <div class="rphotos" id="rphotos"></div>
        <div class="rbody" id="rbody"></div>
        <div class="racts" id="racts"></div>
      </div>

      <div class="card">
        <div class="chdr">
          <span><i class="ti ti-list-check"></i>Tâches</span>
          <button class="btn" style="padding:4px 9px;font-size:10px" onclick="clearTasks()"><i class="ti ti-trash" style="font-size:11px"></i> Vider</button>
        </div>
        <div class="tlist" id="tlist"><div style="font-size:12px;color:#B4B2A9;padding:6px 0;text-align:center">Aucune tâche.</div></div>
      </div>
    </div>

    <!-- PLANNING -->
    <div class="pane" id="p-plan">
      <div class="wnav">
        <button class="narr" onclick="sw(-1)"><i class="ti ti-chevron-left"></i></button>
        <div class="wlbl" id="wlbl"></div>
        <button class="narr" onclick="sw(1)"><i class="ti ti-chevron-right"></i></button>
      </div>
      <div style="display:flex;justify-content:flex-end">
        <button class="btn te" style="padding:8px 14px" onclick="openModal()"><i class="ti ti-plus"></i> Ajouter</button>
      </div>
      <div id="wgrid" style="display:flex;flex-direction:column;gap:7px"></div>
    </div>

    <!-- ÉQUIPE -->
    <div class="pane" id="p-team">
      <div class="card">
        <div class="chdr"><span><i class="ti ti-users"></i>Équipe ISSEO</span></div>
        <div class="mlist" id="mlist"></div>
      </div>
      <div class="card">
        <div class="chdr"><span><i class="ti ti-list-check"></i>Tâches par personne</span></div>
        <div id="mtasks" style="display:flex;flex-direction:column;gap:8px"></div>
      </div>
    </div>

    <!-- RÉCAP -->
    <div class="pane" id="p-recap">
      <div class="card">
        <div class="chdr"><span><i class="ti ti-report"></i>Récap de la journée</span></div>
        <div class="brow">
          <button class="btn te" onclick="genRecap()"><i class="ti ti-sparkles"></i> Générer</button>
          <button class="btn or" onclick="sendGmail()"><i class="ti ti-mail"></i> Gmail ↗</button>
        </div>
        <div id="rcbox" style="display:none">
          <div class="rcbox" id="rcbody"></div>
          <button class="btn fw" style="margin-top:6px" onclick="copyRc()"><i class="ti ti-copy"></i> Copier</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- MODAL PLANNING -->
<div class="mbg" id="mbg" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <div class="mdrag"></div>
    <div class="mt"><i class="ti ti-calendar-plus"></i> Nouvel événement</div>
    <div class="fl">Titre</div>
    <input class="fi" id="evT" placeholder="Ex : Dépannage — Client" style="margin-bottom:9px">
    <div class="g2">
      <div><div class="fl">Date</div><input class="fi" type="date" id="evD" style="margin-bottom:0"></div>
      <div><div class="fl">Heure</div><input class="fi" type="time" id="evH" value="08:00" style="margin-bottom:0"></div>
    </div>
    <div class="fl" style="margin-top:9px">Type</div>
    <div class="tpg">
      <div class="tp" data-t="inter" onclick="selTp(this)" style="background:var(--te-l);color:var(--te-d);border-color:var(--te);border-width:1.5px">Intervention</div>
      <div class="tp" data-t="rdv" onclick="selTp(this)">RDV client</div>
      <div class="tp" data-t="admin" onclick="selTp(this)">Admin/Devis</div>
      <div class="tp" data-t="secu" onclick="selTp(this)">Sécurité</div>
    </div>
    <div class="fl">Technicien</div>
    <div class="whog" id="whog"></div>
    <div class="fl">Client</div>
    <input class="fi" id="evCl" placeholder="Nom du client">
    <div class="macts">
      <button class="mcancel" onclick="closeModal()">Annuler</button>
      <button class="msave" onclick="saveEv()">Enregistrer</button>
    </div>
  </div>
</div>

<script>
const TEAM=[
  {id:'joan',label:'Joan',ini:'JO',role:'Co-gérant',bg:'#EA7807',lt:'#FEF0E0',dk:'#B85E00'},
  {id:'cathy',label:'Cathy',ini:'CA',role:'Co-gérante',bg:'#3AB6AD',lt:'#E0F5F4',dk:'#1E7A74'},
  {id:'florent',label:'Florent',ini:'FL',role:'Équipe',bg:'#7F77DD',lt:'#EEF0FE',dk:'#3C3489'},
  {id:'myriam',label:'Myriam',ini:'MY',role:'Équipe',bg:'#D4537E',lt:'#FDE8F0',dk:'#993556'},
  {id:'cedric',label:'Cédric',ini:'CÉ',role:'Équipe',bg:'#4CAF50',lt:'#E8F3DE',dk:'#3B6D11'}
];
const TC={inter:{bg:'#E0F5F4',c:'#1E7A74',dot:'#3AB6AD'},rdv:{bg:'#FEF0E0',c:'#B85E00',dot:'#EA7807'},admin:{bg:'#F4F4F2',c:'#555',dot:'#888'},secu:{bg:'#FCEBEB',c:'#A32D2D',dot:'#E24B4A'}};
const MN=['jan','fév','mar','avr','mai','jun','jul','aoû','sep','oct','nov','déc'];
const DN=['Lundi','Mardi','Mercredi','Jeudi','Vendredi'];

let cur=null,tasks=[],evs=[];
let phs=[],mic=false,recog=null;
let wkOff=0,curTp='inter',curWh='joan',svT=null;

function initLogin(){
  const g=document.getElementById('pgrid');g.innerHTML='';
  TEAM.forEach(t=>{
    const d=document.createElement('div');d.className='pc';d.id='pc-'+t.id;
    d.innerHTML='<div class="pc-av" style="background:'+t.bg+'">'+t.ini+'</div><div class="pc-name">'+t.label+'</div><div class="pc-role">'+t.role+'</div>';
    d.onclick=()=>selP(t);g.appendChild(d);
  });
}

function selP(t){
  document.querySelectorAll('.pc').forEach(c=>{c.style.borderColor='rgba(255,255,255,.1)';});
  document.getElementById('pc-'+t.id).style.borderColor=t.bg;
  cur=t;document.getElementById('loginGo').classList.add('show');
}

async function doLogin(){
  if(!cur) return;
  document.getElementById('loginScreen').style.display='none';
  document.getElementById('mainApp').style.display='flex';
  document.getElementById('hdrAv').style.background=cur.bg;
  document.getElementById('hdrAv').textContent=cur.ini;
  document.getElementById('hdrNm').textContent=cur.label;
  const p=document.getElementById('wpill');p.textContent=cur.label;p.style.background=cur.lt;p.style.color=cur.dk;
  await loadData();buildWho();renderWeek();renderTeam();
}

function doLogout(){
  if(!confirm('Changer de profil ?')) return;
  document.getElementById('loginScreen').style.display='flex';
  document.getElementById('mainApp').style.display='none';
  document.querySelectorAll('.pc').forEach(c=>c.style.borderColor='rgba(255,255,255,.1)');
  document.getElementById('loginGo').classList.remove('show');
  cur=null;
}

async function loadData(){
  try{const r=await window.storage.get('isseo-t');if(r) tasks=JSON.parse(r.value);}catch(e){}
  try{const r=await window.storage.get('isseo-e');if(r) evs=JSON.parse(r.value);}catch(e){}
  renderTasks();updStats();
}

async function saveData(){
  try{await window.storage.set('isseo-t',JSON.stringify(tasks.map(t=>({...t,photos:[]}))));}catch(e){}
  try{await window.storage.set('isseo-e',JSON.stringify(evs));}catch(e){}
  const el=document.getElementById('sv');el.classList.add('on');
  clearTimeout(svT);svT=setTimeout(()=>el.classList.remove('on'),2500);
}

function gt(t){
  ['home','plan','team','recap'].forEach(x=>{
    document.getElementById('p-'+x).classList.toggle('on',x===t);
    document.getElementById('t-'+x).classList.toggle('on',x===t);
  });
  if(t==='plan') renderWeek();
  if(t==='team') renderTeam();
  document.getElementById('ct').scrollTop=0;
}

function updStats(){
  document.getElementById('sT').textContent=tasks.length;
  document.getElementById('sD').textContent=tasks.filter(t=>t.done).length;
}

function addPh(inp){
  Array.from(inp.files).forEach(f=>{
    const r=new FileReader();
    r.onload=e=>{phs.push({id:'p'+Date.now()+Math.random(),url:e.target.result,file:f});renderPh();};
    r.readAsDataURL(f);
  });inp.value='';
}
function renderPh(){
  const row=document.getElementById('phRow');row.innerHTML='';
  phs.forEach(p=>{const w=document.createElement('div');w.className='phth';w.innerHTML='<img src="'+p.url+'"><button class="phrm" onclick="rmPh(\''+p.id+'\')">×</button>';row.appendChild(w);});
  const ab=document.createElement('div');ab.className='addph';ab.innerHTML='<i class="ti ti-camera"></i><span>Photo</span>';ab.onclick=()=>document.getElementById('fi').click();row.appendChild(ab);
}
function rmPh(id){phs=phs.filter(p=>p.id!==id);renderPh();}

const SYS='Tu es l\'assistant IA d\'ISSEO, manutention/dépannage chariots élévateurs (Joan co-gérant, Cathy co-gérante, Florent, Myriam, Cédric). Réponds UNIQUEMENT en JSON strict sans markdown : {"type":"intervention|devis|commande_piece|planning|rappel|mail|administratif|commercial|securite|rh","urgence":false,"client":"","titre":"","action":"","reponse":"texte complet professionnel","suggestions":["..."],"couleur":"teal|orange|red|purple|green|gray","destinataire":"","sujet":"","pieces_identifiees":"","plan_date":"YYYY-MM-DD ou vide","plan_heure":"HH:MM ou vide","assigne_a":"nom ou vide"}';

async function callIA(messages){
  const r=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({system:SYS,messages,max_tokens:1200})});
  return r.json();
}

async function doSend(){
  const inp=document.getElementById('uIn');const txt=inp.value.trim();
  if(!txt&&phs.length===0) return;
  const myPhs=[...phs];const inst=txt||'Analyser les photos';
  inp.value='';phs=[];renderPh();
  const rc=document.getElementById('resp');rc.classList.add('on');
  document.getElementById('rtype').textContent='Traitement…';
  document.getElementById('rbody').innerHTML='<div class="ld"><span></span><span></span><span></span></div>';
  document.getElementById('racts').innerHTML='';document.getElementById('rphotos').innerHTML='';
  if(myPhs.length){const rp=document.getElementById('rphotos');myPhs.forEach(p=>{const i=document.createElement('img');i.src=p.url;i.alt='';rp.appendChild(i);});}
  const mc=[];
  myPhs.forEach(p=>{mc.push({type:'image',source:{type:'base64',media_type:p.file.type||'image/jpeg',data:p.url.split(',')[1]}});});
  mc.push({type:'text',text:'Instruction de '+cur.label+' : '+inst});
  try{
    const data=await callIA([{role:'user',content:mc}]);
    const raw=data.content.map(c=>c.text||'').join('');
    let p;try{p=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){p={type:'administratif',titre:'Note',action:inst,reponse:raw,urgence:false,client:'',suggestions:[],couleur:'gray',destinataire:'',sujet:'',pieces_identifiees:'',plan_date:'',plan_heure:'',assigne_a:''};}
    p.auteur=cur.label;p.auteurId=cur.id;p.done=false;p.id=Date.now().toString();p.photos=myPhs.map(ph=>ph.url);
    if(p.plan_date&&p.plan_heure) evs.push({id:'ev'+Date.now(),title:p.titre||p.action,date:p.plan_date,time:p.plan_heure,type:'inter',who:p.assigne_a||cur.label,client:p.client||''});
    const dc={teal:'#3AB6AD',orange:'#EA7807',red:'#E24B4A',purple:'#534AB7',green:'#4CAF50',gray:'#888'};
    document.getElementById('rtype').textContent=p.pieces_identifiees?'Pièces identifiées':(p.type||'Agent');
    document.getElementById('rdot').style.background=dc[p.couleur]||'#3AB6AD';
    const rw=document.getElementById('rwho');rw.textContent=p.auteur;rw.style.background=cur.lt;rw.style.color=cur.dk;
    let bt=p.reponse||p.action;if(p.pieces_identifiees) bt='Pièces :\n'+p.pieces_identifiees+'\n\n'+bt;
    document.getElementById('rbody').textContent=bt;
    renderActs(p.suggestions||[],p);
    tasks.unshift(p);renderTasks();updStats();await saveData();
  }catch(err){document.getElementById('rbody').textContent='Erreur serveur ISSEO. Vérifiez votre connexion.';}
}

function renderActs(sugs,t){
  const el=document.getElementById('racts');el.innerHTML='';
  sugs.slice(0,3).forEach(s=>{const b=document.createElement('button');b.textContent=s+' ↗';b.onclick=()=>qp(s);el.appendChild(b);});
  if(t&&t.type==='mail'&&t.destinataire){
    const mb=document.createElement('button');mb.innerHTML='<i class="ti ti-brand-gmail" style="font-size:11px;vertical-align:-1px"></i> Gmail ↗';
    mb.style.cssText='background:var(--or-l);color:var(--or-d);border-color:var(--or);font-size:11px;padding:5px 10px;border-radius:99px;border:0.5px solid;cursor:pointer;font-family:inherit';
    mb.onclick=()=>{const ph=t.photos&&t.photos.length?'\n\n['+t.photos.length+' photo(s) à attacher]':'';window.open('https://mail.google.com/mail/?view=cm&to='+encodeURIComponent(t.destinataire)+'&su='+encodeURIComponent(t.sujet||'ISSEO')+'&body='+encodeURIComponent((t.reponse||'')+ph),'_blank');};
    el.appendChild(mb);
  }
}

function renderTasks(){
  const el=document.getElementById('tlist');el.innerHTML='';
  if(!tasks.length){el.innerHTML='<div style="font-size:12px;color:#B4B2A9;padding:6px 0;text-align:center">Aucune tâche.</div>';return;}
  const im={intervention:['ti-tool','#E0F5F4','#1E7A74'],devis:['ti-file-invoice','#FEF0E0','#B85E00'],commande_piece:['ti-package','#FAECE7','#993C1D'],planning:['ti-calendar','#EEF0FE','#534AB7'],rappel:['ti-phone','#E8F3DE','#3B6D11'],mail:['ti-mail','#F4F4F2','#888'],administratif:['ti-clipboard','#F4F4F2','#888'],commercial:['ti-briefcase','#FEF0E0','#B85E00'],securite:['ti-shield-check','#FCEBEB','#A32D2D'],rh:['ti-user','#EEF0FE','#3C3489']};
  tasks.forEach(t=>{
    const[ic,bg,co]=im[t.type]||['ti-note','#F4F4F2','#888'];
    const pfc=TEAM.find(x=>x.label===t.auteur)||TEAM[0];
    const d=document.createElement('div');d.className='ti';
    d.innerHTML='<div class="tic" style="background:'+bg+'"><i class="ti '+ic+'" style="color:'+co+'"></i></div>'
      +'<div class="tb"><div class="tt">'+x(t.titre||t.action||'Tâche')+(t.urgence?'<span class="ubadge">Urgent</span>':'')+'</div>'
      +'<div class="tm"><span style="font-size:9px;font-weight:600;background:'+pfc.lt+';color:'+pfc.dk+';padding:1px 6px;border-radius:99px">'+x(t.auteur||'')+'</span>'
      +'<span>'+x(t.type||'')+'</span>'+(t.client?'<span>'+x(t.client)+'</span>':'')
      +(t.photos&&t.photos.length?'<span style="font-size:9px;background:var(--or-l);color:var(--or-d);border-radius:99px;padding:1px 5px;font-weight:500"><i class="ti ti-camera" style="font-size:9px;vertical-align:-1px"></i> '+t.photos.length+'</span>':'')
      +'</div></div>'
      +'<div class="tck'+(t.done?' done':'')+'" id="ck-'+t.id+'" onclick="togDone(\''+t.id+'\',event)"><i class="ti ti-check"></i></div>';
    d.querySelector('.tb').onclick=()=>showDet(t);
    el.appendChild(d);
  });
}

function x(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

function togDone(id,e){
  e.stopPropagation();const t=tasks.find(i=>i.id===id);if(!t) return;
  t.done=!t.done;document.getElementById('ck-'+id).classList.toggle('done',t.done);
  updStats();saveData();
}

function showDet(t){
  const pfc=TEAM.find(i=>i.label===t.auteur)||TEAM[0];
  document.getElementById('resp').classList.add('on');
  document.getElementById('rtype').textContent=t.type||'Tâche';
  const dc={teal:'#3AB6AD',orange:'#EA7807',red:'#E24B4A',purple:'#534AB7',green:'#4CAF50',gray:'#888'};
  document.getElementById('rdot').style.background=dc[t.couleur]||'#3AB6AD';
  const rw=document.getElementById('rwho');rw.textContent=t.auteur||'';rw.style.background=pfc.lt;rw.style.color=pfc.dk;
  const rp=document.getElementById('rphotos');rp.innerHTML='';(t.photos||[]).forEach(s=>{const i=document.createElement('img');i.src=s;i.alt='';rp.appendChild(i);});
  let bt=t.reponse||t.action||'';if(t.pieces_identifiees) bt='Pièces :\n'+t.pieces_identifiees+'\n\n'+bt;
  document.getElementById('rbody').textContent=bt;
  renderActs(t.suggestions||[],t);
  document.getElementById('ct').scrollTop=0;
}

async function clearTasks(){if(!confirm('Vider toutes les tâches ?')) return;tasks=[];renderTasks();updStats();await saveData();}

function openRedist(){
  const pending=tasks.filter(t=>!t.done);
  if(!pending.length){alert('Aucune tâche en attente.');return;}
  const list=document.getElementById('rdList');list.innerHTML='';
  pending.forEach(t=>{
    const d=document.createElement('div');d.className='rdi';
    const sel=document.createElement('select');sel.className='rds';sel.dataset.tid=t.id;
    TEAM.forEach(n=>{const o=document.createElement('option');o.value=n.label;o.textContent=n.label;if(n.label===t.auteur) o.selected=true;sel.appendChild(o);});
    d.innerHTML='<div class="rdt">'+x(t.titre||t.action)+'</div>';d.appendChild(sel);list.appendChild(d);
  });
  document.getElementById('redistCard').style.display='block';
  document.getElementById('ct').scrollTop=0;
}

async function confirmRedist(){
  document.querySelectorAll('.rds').forEach(sel=>{
    const t=tasks.find(i=>i.id===sel.dataset.tid);
    if(t){t.auteur=sel.value;const pfc=TEAM.find(i=>i.label===sel.value);if(pfc) t.auteurId=pfc.id;}
  });
  document.getElementById('redistCard').style.display='none';
  renderTasks();renderTeam();await saveData();
}

function renderTeam(){
  const ml=document.getElementById('mlist');ml.innerHTML='';
  const mt=document.getElementById('mtasks');mt.innerHTML='';
  TEAM.forEach(m=>{
    const cnt=tasks.filter(t=>t.auteur===m.label&&!t.done).length;
    const d=document.createElement('div');d.className='mi';
    d.innerHTML='<div class="mav" style="background:'+m.bg+'">'+m.ini+'</div>'
      +'<div class="minf"><div class="mnm">'+m.label+'</div><div class="mrl">'+m.role+'</div></div>'
      +'<div class="mtk" style="background:'+m.lt+';color:'+m.dk+'">'+cnt+' tâche'+(cnt>1?'s':'')+'</div>';
    ml.appendChild(d);
    const mt2=tasks.filter(t=>t.auteur===m.label);
    if(mt2.length){
      const sec=document.createElement('div');
      sec.innerHTML='<div style="font-size:10px;font-weight:600;color:'+m.dk+';background:'+m.lt+';padding:4px 9px;border-radius:99px;display:inline-block;margin-bottom:5px">'+m.label+'</div>';
      mt2.slice(0,4).forEach(t=>{
        const ti=document.createElement('div');
        ti.style.cssText='font-size:11px;color:var(--dk);padding:5px 0;border-bottom:0.5px solid var(--bd);display:flex;align-items:center;gap:6px';
        ti.innerHTML='<i class="ti '+(t.done?'ti-check" style="color:var(--te)':'ti-clock" style="color:var(--gr)')+';font-size:12px"></i>'+x(t.titre||t.action||'Tâche');
        sec.appendChild(ti);
      });
      mt.appendChild(sec);
    }
  });
}

async function genRecap(){
  document.getElementById('rcbox').style.display='block';
  const rb=document.getElementById('rcbody');
  rb.innerHTML='<div class="ld"><span></span><span></span><span></span></div>';
  const s=tasks.map(t=>'['+(t.done?'FAIT':'EN ATTENTE')+'] '+t.auteur+' — '+t.type+' — '+(t.titre||t.action)+(t.client?' ('+t.client+')':'')+(t.urgence?' [URGENT]':'')).join('\n')||'Aucune tâche.';
  try{
    const data=await callIA([{role:'user',content:'Date : '+new Date().toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long'})+'\nÉquipe ISSEO — Tâches :\n'+s+'\nGénère un récap pro fin de journée par personne avec priorités demain.'}]);
    rb.textContent=data.content.map(c=>c.text||'').join('');
  }catch(e){rb.textContent='Erreur lors de la génération.';}
}

function copyRc(){navigator.clipboard.writeText(document.getElementById('rcbody').textContent).catch(()=>{});}
function sendGmail(){const t=document.getElementById('rcbody').textContent;if(!t)return;window.open('https://mail.google.com/mail/?view=cm&su='+encodeURIComponent('Récap ISSEO — '+new Date().toLocaleDateString('fr-FR'))+'&body='+encodeURIComponent(t),'_blank');}

function getMon(off){const n=new Date();const m=new Date(n);m.setDate(m.getDate()-m.getDay()+1+off*7);m.setHours(0,0,0,0);return m;}
function getWkDays(off){const m=getMon(off);return Array.from({length:5},(_,i)=>{const d=new Date(m);d.setDate(d.getDate()+i);return d;});}
function isoD(d){return d.toISOString().split('T')[0];}
function isToday(d){const t=new Date();return d.getDate()===t.getDate()&&d.getMonth()===t.getMonth()&&d.getFullYear()===t.getFullYear();}
function sw(n){wkOff+=n;renderWeek();}

function renderWeek(){
  const days=getWkDays(wkOff);
  const m=days[0],fr=days[4];
  document.getElementById('wlbl').textContent=m.getDate()+' '+MN[m.getMonth()]+' – '+fr.getDate()+' '+MN[fr.getMonth()];
  const grid=document.getElementById('wgrid');grid.innerHTML='';
  days.forEach(day=>{
    const iso=isoD(day);
    const dayEvs=evs.filter(e=>e.date===iso).sort((a,b)=>a.time.localeCompare(b.time));
    const col=document.createElement('div');col.className='dc'+(isToday(day)?' tod':'');
    const dn=DN[day.getDay()-1]||DN[0];
    const hdr=document.createElement('div');hdr.className='dhdr';
    hdr.innerHTML='<span class="dnm">'+dn+'</span><span class="ddt">'+day.getDate()+' '+MN[day.getMonth()]+'</span>';
    col.appendChild(hdr);
    if(!dayEvs.length){const e=document.createElement('div');e.className='demp';e.textContent='Rien de prévu';col.appendChild(e);}
    else{
      const ed=document.createElement('div');ed.className='devts';
      dayEvs.forEach(ev=>{
        const cfg=TC[ev.type]||TC.inter;
        const pfc=TEAM.find(t=>t.label===ev.who)||TEAM[0];
        const e=document.createElement('div');e.className='ev';e.style.cssText='background:'+cfg.bg+';border-left:2px solid '+cfg.dot;
        e.innerHTML='<div class="et" style="color:'+cfg.c+'">'+ev.time+'</div><div class="etl" style="color:'+cfg.c+'">'+x(ev.title)+'</div><div class="ewho" style="background:'+pfc.lt+';color:'+pfc.dk+'">'+x(ev.who)+'</div>';
        ed.appendChild(e);
      });
      col.appendChild(ed);
    }
    const ab=document.createElement('button');ab.className='dadd';ab.innerHTML='<i class="ti ti-plus" style="font-size:10px"></i> Ajouter';
    ab.onclick=()=>{document.getElementById('evD').value=iso;buildWho();openModal();};
    col.appendChild(ab);grid.appendChild(col);
  });
}

function buildWho(){
  const g=document.getElementById('whog');g.innerHTML='';
  TEAM.forEach(t=>{
    const b=document.createElement('button');b.className='wb';b.textContent=t.label;b.dataset.id=t.id;
    if(t.id===curWh){b.style.background=t.lt;b.style.color=t.dk;b.style.borderColor=t.bg;}
    b.onclick=()=>{curWh=t.id;document.querySelectorAll('#whog .wb').forEach(i=>{i.style.background='';i.style.color='';i.style.borderColor='';});b.style.background=t.lt;b.style.color=t.dk;b.style.borderColor=t.bg;};
    g.appendChild(b);
  });
}

function openModal(){buildWho();document.getElementById('mbg').classList.add('on');}
function closeModal(){document.getElementById('mbg').classList.remove('on');}
function selTp(el){document.querySelectorAll('.tp').forEach(b=>b.style.cssText='');const cfg=TC[el.dataset.t]||TC.inter;el.style.cssText='background:'+cfg.bg+';color:'+cfg.c+';border-color:'+cfg.dot+';border-width:1.5px';curTp=el.dataset.t;}

async function saveEv(){
  const t=document.getElementById('evT').value.trim(),d=document.getElementById('evD').value,h=document.getElementById('evH').value||'08:00',cl=document.getElementById('evCl').value.trim();
  if(!t||!d){alert('Titre et date requis.');return;}
  const pfc=TEAM.find(i=>i.id===curWh)||TEAM[0];
  evs.push({id:'ev'+Date.now(),title:t,date:d,time:h,type:curTp,who:pfc.label,client:cl});
  closeModal();document.getElementById('evT').value='';document.getElementById('evCl').value='';
  renderWeek();await saveData();
}

function toggleMic(){
  if(!('webkitSpeechRecognition' in window||'SpeechRecognition' in window)){alert('Reconnaissance vocale : Chrome uniquement.');return;}
  const btn=document.getElementById('micBtn');
  if(mic){if(recog) recog.stop();mic=false;btn.classList.remove('rec');return;}
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  recog=new SR();recog.lang='fr-FR';recog.interimResults=false;
  recog.onresult=e=>{document.getElementById('uIn').value=e.results[0][0].transcript;mic=false;btn.classList.remove('rec');doSend();};
  recog.onerror=()=>{mic=false;btn.classList.remove('rec');};
  recog.onend=()=>{mic=false;btn.classList.remove('rec');};
  recog.start();mic=true;btn.classList.add('rec');
}

function qp(t){document.getElementById('uIn').value=t;document.getElementById('uIn').focus();}
document.getElementById('uIn').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();doSend();}});
document.getElementById('evD').value=new Date().toISOString().split('T')[0];
initLogin();
</script>
</body>
</html>
